<% layout("layouts/boilerPlate") -%>
<link rel="stylesheet" href="/css/edit.css" />
<%- include("../includes/flash.ejs") %>
<main class="edit-listing-page">
  <section class="edit-listing-card">
    <h1>Edit Your Listing</h1>

    <form method="POST" action="/listings/<%= data._id %>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">
      
      <div class="form-group">
        <div class="image-style-form">
           <img src="<%= data.image.url %>" alt="<%= data.title %>">
        </div>
      </div>

      <div class="form-group">
        <label for="title">Title</label>
        <input id="title" name="listing[title]" value="<%= data.title %>" type="text" required>
        <div class="invalid-feedback">Plese Enter a Title.</div>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="listing[description]" required><%= data.description%></textarea>
        <div class="invalid-feedback">Plese Enter a Short Description.</div>
      </div>

      <div class="form-group">
        <label for="image">Upload new Image</label>
        <input
        id="image" name="listing[image]" type="file">
        <div class="invalid-feedback">Plese Upload a Image.</div>
      </div>

      <div class="form-group">
        <label for="price">Price</label>
        <input id="price" name="listing[price]" value="<%= data.price %>" type="number" required>
        <div class="invalid-feedback">Plese Enter a Price.</div>
      </div>

      <div class="form-group">
        <label for="location">Location</label>
        <input id="location" name="listing[location]" value="<%= data.location %>" type="text" required>
        <div class="invalid-feedback">Plese Locations.</div>
      </div>

      <div class="form-group">
        <label for="country">Country</label>
        <input id="country" name="listing[country]" value="<%= data.country %>" type="text" required>
        <div class="invalid-feedback">Plese enter a Country.</div>
      </div>

      <button class="update-btn" type="submit">Update Listing</button>
    </form>
  </section>
</main>