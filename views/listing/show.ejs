<% layout("layouts/boilerPlate") -%>
<%- include("../includes/flash.ejs") %>

<script>
  const maptoken = "<%= process.env.MAP_token %>";
  const coordinate = <%- JSON.stringify(data.geometry.coordinates) %>;
  const title = "<%= data.title %>";
const listingId = "<%= data._id %>";
</script>
<link rel="stylesheet" href="/css/show.css">
<main class="listing-details-page">
  <section class="listing-details-card">
    <div class="listing-header">
      <h1><%= data.title %></h1>
    </div>

    <div class="image-style-form">
           <img src="<%= data.image.url %>" alt="<%= data.title %>">
      </div>

    <ul class="listing-info">

      <li>
        <span class="label">username</span>
        <%= data.owner ? data.owner.username : "ravi" %>
      </li>

      <li>
        <span class="label">Listing ID</span>
        <%= data.id %>
      </li>

      <li>
        <span class="label">Title</span>
        <%= data.title %>
      </li>

      <li>
        <span class="label">Description</span>
        <%= data.description %>
      </li>
      
      <li>
        <span class="label">Price</span>
        <span class="price">₹<%= data.price != null ? Number(data.price).toLocaleString("en-IN") : "Not available" %></span>
      </li>
      
      <li>
        <span class="label">location</span>
        <%= data.location %>
      </li>

      <li>
        <span class="label">Country</span>
        <%= data.country %>
      </li>
    </ul>

    <% if (currUser && data.owner && currUser._id.equals(data.owner._id)) { %>
    <div class="listing-actions">
      <a class="edit-btn" href="/listings/<%= data._id %>/edit">Edit Listing</a>

      <form method="POST" action="/listings/<%= data._id %>?_method=DELETE">
        <button class="delete-btn" type="submit">Delete</button>
      </form>
    </div>
    <hr>
    <%}%>

    <%if(currUser) {%>
    <div class="rating">
      <form method="POST" action="/listings/<%=data._id%>/review" novalidate class="needs-validation">
      
        <div class="ratings">
     <div class="h1"><h5>Leave a review</h5></div>
    <div class="stars">
        <input type="radio" id="star5" name="review[rating]" value="5">
        <label for="star5">★</label>

        <input type="radio" id="star4" name="review[rating]" value="4">
        <label for="star4">★</label>

        <input type="radio" id="star3" name="review[rating]" value="3">
        <label for="star3">★</label>

        <input type="radio" id="star2" name="review[rating]" value="2">
        <label for="star2">★</label>

        <input type="radio" id="star1" name="review[rating]" value="1">
        <label for="star1">★</label>
    </div>
</div>

        <div class="comment-btn">
          <div class="comment">
          <textarea name="review[comment]" id="comment" placeholder="add an comment" cols="35" row="10" required></textarea>
          <div class="invalid-feedback">plese add some comment.</div>
          </div>

        <button class="button">submit</button>
        </div>
      </form>
    </div>
    <% }%>
    <!-- <div class="review">
      <h5>Guest Reviews</h5>

    <% data.reviews.forEach(review => { %>
      <p>Comment: <%= review.comment %></p>
      <p>Rating: <%= review.rating %></p>
    <% }) %>
    </div> -->

    <div class="reviews-section">
    <h5 class="review-head">What Our Guests Say</h5>

    <div class="reviews-container">
        <% data.reviews.forEach(review => { %>

            <div class="review-card">

                <div class="review-header">
                    <div class="review-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <h5><%= review.author.username %></h5>
                        <div class="stars">
                            <% for(let i = 1; i <= 5; i++) { %>
                                <% if(i <= review.rating) { %>
                                    <i class="fa-solid fa-star"></i>
                                <% } else { %>
                                    <i class="fa-regular fa-star"></i>
                                <% } %>
                            <% } %>
                        </div>
                    </div>
                </div>

                <p class="review-comment">
                    "<%= review.comment %>"
                </p>
                <!-- delete -->
                  <form method="POST" action="/listings/<%=data._id%>/review/<%= review._id%>?_method=DELETE">
                    <button>Delete</button>
                  </form>
            </div>

        <% }) %>
        
    </div>
</div>
  </section>
</main>
<div class="map-section col-10 col-md-8 offset-md-2 mb-5">
  <h2>Where you'll be</h2>

  <div id="map"></div>
</div>

<script src="/script/map.js"></script>